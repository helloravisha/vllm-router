# Settings that rarely change. WHAT to run (model, replicas, policy, ports) is in stack.txt.
# Any setting can be overridden for one run with an environment variable, e.g.  POLICY=round_robin ./start-stack.sh

ROUTER_IMAGE="${ROUTER_IMAGE:-vllm-router:0.1.17}"                  # built by ./setup.sh; change only to upgrade (docs/ROADMAP.md)
ROUTER_NAME="${ROUTER_NAME:-vllm-router}"                            # Docker container name
VLLM_API_KEY="${VLLM_API_KEY:-dummy}"                                # the vLLM servers' --api-key; clients send the same key to the router
VLLM_SERVING_DIR="${VLLM_SERVING_DIR:-$HOME/vllm-serving}"           # github.com/helloravisha/vllm-serving (serve.sh + model configs)
STACK_FILE="${STACK_FILE:-stack.txt}"                                # what start-stack.sh runs
WORKERS_FILE="${WORKERS_FILE:-workers.txt}"                          # only for start-router.sh with vLLM started elsewhere

# Values from stack.txt: "key: value" lines, comments after #. Prints one line per active entry.
stack_value() {
  [[ -f "$STACK_FILE" ]] || return 0
  sed -n -E "s/^[[:space:]]*$1[[:space:]]*:[[:space:]]*([^#]*).*/\1/p" "$STACK_FILE" | sed -E 's/[[:space:]]+$//'
}

# The ports and policy every script uses: environment variable, else stack.txt, else the default
ROUTER_PORT="${ROUTER_PORT:-$(stack_value router_port | head -1)}";   ROUTER_PORT="${ROUTER_PORT:-30000}"
METRICS_PORT="${METRICS_PORT:-$(stack_value metrics_port | head -1)}"; METRICS_PORT="${METRICS_PORT:-29000}"
POLICY="${POLICY:-$(stack_value policy | head -1)}";                   POLICY="${POLICY:-cache_aware}"
