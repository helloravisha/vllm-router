# Settings for the scripts in this folder. Override any of them on the command line, e.g.
#   POLICY=round_robin ./start-router.sh
ROUTER_IMAGE="${ROUTER_IMAGE:-vllm-router:0.1.17}"   # built by ./setup.sh
ROUTER_NAME="${ROUTER_NAME:-vllm-router}"            # Docker container name
ROUTER_PORT="${ROUTER_PORT:-30000}"                  # OpenAI-compatible API (/v1/chat/completions, /v1/models)
METRICS_PORT="${METRICS_PORT:-29000}"                # Prometheus metrics (/metrics)
POLICY="${POLICY:-cache_aware}"                      # cache_aware | round_robin | power_of_two | random | consistent_hash | ...
VLLM_API_KEY="${VLLM_API_KEY:-dummy}"                # the workers' --api-key; clients send the same key to the router
WORKERS_FILE="${WORKERS_FILE:-workers.txt}"          # one vLLM URL per line, as seen from this machine

# Used by start-stack.sh / stop-stack.sh (vLLM replicas + router in one go)
VLLM_SERVING_DIR="${VLLM_SERVING_DIR:-$HOME/vllm-serving}"           # github.com/helloravisha/vllm-serving (has serve.sh)
MODEL_CONFIG="${MODEL_CONFIG:-configs/mac/qwen2.5-1.5b.yaml}"        # the model every replica serves (path inside VLLM_SERVING_DIR)
REPLICA_PORTS="${REPLICA_PORTS:-8000 8010}"                           # one vLLM replica per port
